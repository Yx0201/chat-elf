# 复制为 .env.local 并填入真实值;真实 .env.local 不入库。
# 全部为服务端专用变量:模型密钥与派生信息绝不加 NEXT_PUBLIC_ 前缀(见 ARCHITECTURE.md)。

# 实时语音接入通道:tokenplan(默认)| dashscope,二选一切换
REALTIME_PROVIDER=tokenplan

# —— 通道一:Token Plan(百炼订阅服务,当前默认)——
# Token Plan 的 API Key(百炼控制台获取)
TOKENPLAN_API_KEY=sk-xxx
# 以下可选,一般无需修改:
# TOKENPLAN_REGION=cn-beijing
# TOKENPLAN_MODEL=qwen-audio-3.0-realtime-plus
# TOKENPLAN_SIGNALING_URL=  (整段覆盖信令端点,默认拼装
#   https://token-plan.{region}.maas.aliyuncs.com/api/v1/webrtc/realtime?model={model})

# —— 通道二:DashScope(百炼业务空间,切回时设 REALTIME_PROVIDER=dashscope)——
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_WORKSPACE_ID=xxx
DASHSCOPE_REGION=cn-beijing

# —— 持久化:PostgreSQL(本地 → 上线 Neon)—— 服务端专用 ——
# 本地开发:postgres://<用户名>@localhost:5432/chat_elf
# 上线 Neon:运行时查询用 pooled 串(-pooler 后缀,内置 PgBouncer);
#           迁移 / DDL 走非 pooled 直连串(事务模式池化会破坏 session 级状态)。
DATABASE_URL=postgres://bbimasheep@localhost:5432/chat_elf

# —— 记忆抽取 / 语义检索(AI SDK 经 DashScope OpenAI 兼容模式)——
# 兼容端点。默认 https://dashscope.aliyuncs.com/compatible-mode/v1(公共云);
# 官方另有业务空间写法 https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1,
# 2026-08-29 实测两者均可用且返回一致结果,需要时取消注释切换。
# DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文本向量模型。维度 1024 是 v3 / v4 / qwen3.7-text-embedding 的**默认**维度,
# 换模型若修改了 dimensions,需同步改 memories.embedding 的列宽。
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# 记忆抽取 / 会话摘要用的文本模型
# DASHSCOPE_TEXT_MODEL=qwen-plus

# Supabase:持久化已改为 DATABASE_URL 直连 PostgreSQL(见 ARCHITECTURE.md
# 「持久化架构」),Supabase 降级为将来引入账号体系时 Auth 的候选项。
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY 已废弃,不再需要配置。
