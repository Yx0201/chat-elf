# ┌────────────────────────────────────────────────────────────────┐
# │ chat-elf 环境变量模板                                            │
# │ 复制为 .env.local 并填真实值;真实 .env.local 不入库。              │
# │ 全部为服务端专用:密钥绝不加 NEXT_PUBLIC_ 前缀(ARCHITECTURE.md)。  │
# │ 生产环境的变量在 Vercel 项目 Settings → Environment Variables。    │
# └────────────────────────────────────────────────────────────────┘

# ── 1. 持久化(必填)───────────────────────────────────────────────
# 本地开发:postgres://<用户名>@localhost:5432/chat_elf
# 上线 Neon:运行时查询用 pooled 串(-pooler 后缀,内置 PgBouncer);
#           迁移/DDL 用非 pooled 直连串(事务池化会破坏 session 级状态)。
DATABASE_URL=postgres://bbimasheep@localhost:5432/chat_elf

# ── 2. 账号体系(必填)─────────────────────────────────────────────
# 签名密钥。生成:openssl rand -base64 32 或 pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
# 应用对外地址。本地默认 http://localhost:3000;部署 Vercel 后改为线上域名。
BETTER_AUTH_URL=http://localhost:3000

# ── 3. 语音实时链路(必填,二选一通道)───────────────────────────────
# 通道切换:tokenplan(默认,百炼订阅) | dashscope(百炼业务空间)
REALTIME_PROVIDER=dashscope

# 通道一:Token Plan(百炼订阅服务)。REALTIME_PROVIDER=tokenplan 时必填。
TOKENPLAN_API_KEY=
# 以下可选(有代码默认值):
# TOKENPLAN_REGION=cn-beijing
# TOKENPLAN_MODEL=qwen-audio-3.0-realtime-plus
# TOKENPLAN_SIGNALING_URL=   (整段覆盖信令端点,默认拼装
#   https://token-plan.{region}.maas.aliyuncs.com/api/v1/webrtc/realtime?model={model})

# 通道二:DashScope(百炼业务空间)。REALTIME_PROVIDER=dashscope 时必填;
# DASHSCOPE_API_KEY 同时供 AI SDK 文本/向量、知识库 rerank、TTS 试听共用。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# 可选,默认 cn-beijing
# DASHSCOPE_REGION=cn-beijing

# ── 4. 知识库原文存储(用知识库功能则必填)─────────────────────────
# Vercel Dashboard → Storage → Blob store → 连接项目(环境含 Development)
# 后 `vercel env pull` 获得。本地注意:.env.local 里不要留 VERCEL_OIDC_TOKEN
# (Blob SDK 见到它会优先走 OIDC,而 OIDC 仅 Vercel 运行时有效)。
BLOB_READ_WRITE_TOKEN=
# 随 token 一起下发;SDK 在 OIDC 模式配对用,本地静态 token 下可不填
BLOB_STORE_ID=

# ── 5. 可选覆盖(全部有代码默认值,不了解就不动)────────────────────
# AI SDK 兼容端点(默认 https://dashscope.aliyuncs.com/compatible-mode/v1)
# DASHSCOPE_COMPATIBLE_BASE_URL=
# 文本模型:记忆抽取/画像/知识库(图谱抽取/摘要/问答)。默认 qwen3.7-flash
# (非思考 0.6-1.5s/次、30000RPM、输入0.2/输出0.8元,2026-09-06 实测切换:
# 2.5MB 小说图谱抽取一小时→14分钟,质量不降)。GLM 系强制思考且 200RPM,
# 不适合批量摄取;低延迟场景继续用非思考模型。
# DASHSCOPE_TEXT_MODEL=qwen3.7-flash
# 文本向量模型(维度 1024;换模型若改 dimensions 需同步改
# memories.embedding / document_chunks.embedding 列宽)
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# 向量通道覆盖:设此项后向量走独立 OpenAI 兼容端点(本地 Ollama 等),
# 文本/重排/realtime 不受影响;生产不设 = 走百炼。
# 本地开发例:EMBEDDING_BASE_URL=http://localhost:11434/v1
#          DASHSCOPE_EMBEDDING_MODEL=qwen3-embedding:4b
#          (原生 2560 维,代码经 MRL dimensions=1024 截断,与库列兼容)
# ⚠️ 不同模型的向量空间互不兼容,切换后旧向量需重生成,不可混用。
# EMBEDDING_BASE_URL=
# 覆盖端点的 API Key(Ollama 无鉴权,默认占位 "ollama")
# EMBEDDING_API_KEY=
# 知识库重排(DashScope 原生 rerank 端点,非 OpenAI 兼容)
# DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank

# ── 6. 知识库管线可调参数(全部可选,默认值如下)─────────────────────
# KB_EMBEDDING_BATCH_SIZE=10        # 摄取嵌入批大小(DashScope 单请求上限 10,内部已分批)
# KB_SPLIT_BATCH_SIZE=40            # 检索分块每请求处理的父块数(防 60s 函数时长墙;远程库 40 块≈7s)
# KB_VECTOR_TOP_K=50 / KB_KEYWORD_TOP_K=50 / KB_FUSION_TOP_K=30
# KB_RERANK_TOP_K=10 / KB_FINAL_TOP_K=10 / KB_GRAPH_CHANNEL_TOP_K=10
# KB_RRF_K=60 / KB_MIN_RERANK_SCORE=0.05 / KB_MIN_RERANK_KEEP=3
# KB_GRAPH_BUILD_CONCURRENCY=8     # 图谱抽取初始并发(AIMD 自适应 1~24)
# KB_GRAPH_BUILD_MAX_CONCURRENCY=24
# KB_ENTITY_MERGE_SIMILARITY=0.92 / KB_GRAPH_ENTITY_MATCH_SIMILARITY=0.6
